<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvOptionDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quản Lý Topping Món Ăn"
        android:textColor="#00B14F"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:id="@+id/layoutExistingOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Thêm Topping / Tùy chọn Mới:"
        android:textColor="#212121"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp" />

    <EditText
        android:id="@+id/etOptionName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Tên tùy chọn (Ví dụ: Sốt Phô Mai)"
        android:minHeight="48dp"
        android:layout_marginTop="4dp" />

    <EditText
        android:id="@+id/etOptionPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Giá cộng thêm (VND, ví dụ: 10000)"
        android:inputType="number"
        android:minHeight="48dp"
        android:layout_marginTop="6dp" />

    <Button
        android:id="@+id/btnAddOption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Thêm Topping Này"
        android:textColor="@android:color/white"
        android:backgroundTint="#00B14F"
        android:layout_marginTop="12dp" />

</LinearLayout>
