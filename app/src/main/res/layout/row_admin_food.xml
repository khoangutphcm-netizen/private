<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivAdminFood"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_seveneleven"
            android:contentDescription="Admin Food Image" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvAdminFoodName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Food Name"
                android:textColor="#212121"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAdminFoodPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="50,000 VND"
                android:textColor="#00B14F"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <Button
                    android:id="@+id/btnToggleAvailability"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="● Còn hàng"
                    android:textColor="#00B14F"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:backgroundTint="#E8F5E9"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp" />

                <Button
                    android:id="@+id/btnManageOptions"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="+ Topping"
                    android:textColor="#1976D2"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:backgroundTint="#E3F2FD"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

        </LinearLayout>

        <ImageButton
            android:id="@+id/btnEditFood"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Edit Food"
            android:src="@android:drawable/ic_menu_edit"
            app:tint="#1976D2" />

        <ImageButton
            android:id="@+id/btnDeleteFood"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Delete Food"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="#D32F2F" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
